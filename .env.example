# ---------------------------------------------------------------------------
# Voltix Commerce — environment template  (United Arab Emirates)
# Copy to .env and fill in. NEVER commit .env.
# Validated at boot by packages/config; the process refuses to start if a
# required variable is missing or malformed (fail fast > fail at 2am).
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Core ------------------------------------------------------------------
# Port 5433 deliberately — a locally installed Postgres usually holds 5432, and
# a clash produces a confusing "database exists but has no tables" failure.
# The application connects as the RESTRICTED role. This is what makes row-level
# security real: a superuser bypasses every policy silently.
DATABASE_URL=postgres://voltix_app:voltix_app_dev_password@localhost:5433/voltix
# Owner role — migrations, seed, and cross-tenant background jobs only.
DATABASE_ADMIN_URL=postgres://voltix:voltix_dev_password@localhost:5433/voltix
#
# Cloud Postgres (Neon / RDS / Cloud SQL) instead of Docker:
#   1. Point DATABASE_ADMIN_URL at the provider's owner role and run
#      `npm run db:migrate` — it creates the restricted `voltix_app` role and,
#      because managed Postgres never grants BYPASSRLS, an explicit
#      `admin_bypass` policy for the owner (see packages/db/sql/policies.sql).
#   2. Set a real password: ALTER ROLE voltix_app LOGIN PASSWORD '<generate one>';
#   3. Point DATABASE_URL at voltix_app. Use `sslmode=verify-full` — the pool
#      verifies the certificate chain; `channel_binding` is a libpq-only
#      parameter and can be dropped.
# DATABASE_URL=postgresql://voltix_app:<password>@<host>/<db>?sslmode=verify-full
# DATABASE_ADMIN_URL=postgresql://<owner>:<password>@<host>/<db>?sslmode=verify-full
DATABASE_REPLICA_URL=
REDIS_URL=redis://localhost:6379

# --- Market ----------------------------------------------------------------
# Regional behaviour is configuration, not a compile-time constant: VAT rates
# and thresholds are set by the Federal Tax Authority and do change.
DEFAULT_COUNTRY=AE
DEFAULT_CURRENCY=AED
DEFAULT_LOCALE=en-AE
DEFAULT_TIMEZONE=Asia/Dubai
# UAE VAT in basis points. 500 = 5%.
VAT_RATE_BPS=500
# UAE requires consumer-facing prices to be displayed VAT-inclusive.
VAT_PRICES_INCLUSIVE=true
# 15-digit Tax Registration Number. Required in production — a UAE tax invoice
# without one is not valid and a business customer will reject it.
MERCHANT_TRN=
MERCHANT_LEGAL_NAME=

# Change-of-mind return window, in whole days. Default 14.
#
# Configuration rather than a constant because the number is not settled law. A
# 14-day cooling-off right for online purchases is widely reported but was not
# found in the primary text of the sources reviewed (PRD L-06 / open question
# Q-08); counsel has to confirm it against Cabinet Decision 66/2023. When they
# rule, this changes with a restart rather than a deploy.
#
# It drives the published /returns policy AND the returns workflow from one
# place, so the two cannot disagree. A malformed value falls back to 14 and logs
# — publishing "NaN days" to customers is worse than publishing the old number.
# The 30-day defective-goods window is NOT configurable: it tracks a statutory
# right, not a merchant choice.
RETURNS_CHANGE_OF_MIND_DAYS=14

# --- Auth ------------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-bytes-of-random
AUTH_URL=http://localhost:3000
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --- AI --------------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_BALANCED=claude-sonnet-5
AI_MODEL_DEEP=claude-opus-5
# Hard ceiling on AI spend per merchant per day, USD. Requests over the cap are
# rejected with a typed error rather than silently draining the budget.
AI_DAILY_BUDGET_USD=25
VOYAGE_API_KEY=

# --- Object storage (S3 compatible: R2 / MinIO / S3) ------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=voltix-media
S3_ACCESS_KEY_ID=voltix
S3_SECRET_ACCESS_KEY=voltix_dev_password
CDN_BASE_URL=http://localhost:9000/voltix-media

# Fallback when the S3 keys above are unset: product images are written to the
# storefront's public/ tree so a fresh clone can upload one with no object
# store running. Development only — packages/media refuses it in production.
# MEDIA_LOCAL_DIR=apps/storefront/public/uploads
# MEDIA_LOCAL_BASE_URL=/uploads

# --- Payments --------------------------------------------------------------
# Every gateway is optional. Absent credentials disable that adapter; the
# checkout only offers methods that are actually configured.

# Cards, Apple Pay and Google Pay. Wallet share is high in the UAE and both
# ride the card rails through Stripe rather than needing their own adapter.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Network International (N-Genius) — the incumbent UAE domestic acquirer.
# Many established merchants already hold an account through their bank.
NETWORK_API_KEY=
NETWORK_OUTLET_REF=
NETWORK_SANDBOX=true

# Tabby — buy now, pay later. A basket-size lever on higher-value handsets,
# not a card alternative. Tabby underwrites the shopper and settles you in full.
TABBY_SECRET_KEY=
TABBY_PUBLIC_KEY=
TABBY_MERCHANT_CODE=
TABBY_WEBHOOK_SECRET=

# PayTabs — regional MENA gateway; the usual alternative to Network.
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=

# Cash on delivery. Still a real share of UAE e-commerce, and still shrinking.
COD_ENABLED=true
# Fils. Above this, COD is refused and online payment is offered instead.
# 500000 = AED 5,000.
COD_MAX_ORDER_AMOUNT=500000
# Standing deposit for every COD order, in basis points of the total. 0 = none.
# 2000 = 20%. This is the control against COD refusal losses: a customer who has
# paid something turns up. It is enforced in checkout, not just displayed.
COD_ADVANCE_BPS=0
# Deposit demanded when the risk model flags a specific order, in basis points.
# Defaults to COD_ADVANCE_BPS. Set this higher to leave most customers alone
# while still asking a flagged order for a deposit — with both at 0, a flagged
# order gets no deposit and only the risk ceiling below applies.
COD_RISK_ADVANCE_BPS=
# Flat COD handling fee in fils. Common UAE practice. 1000 = AED 10.
COD_HANDLING_FEE=0

# --- Notifications ---------------------------------------------------------
# Email needs one of RESEND_API_KEY or SMTP_URL. With neither, the store still
# boots and still records every message — it just prints them instead of
# sending, which in production is a customer who is never told anything.
#
# RESEND_API_KEY wins when both are set, because SMTP_URL below ships pointing
# at localhost: an env file copied to a server would otherwise post every
# receipt to a mail server that is not there.
RESEND_API_KEY=
# Signing secret for Resend's delivery webhooks — the `whsec_…` value on the
# webhook's detail page, NOT the API key. Point the webhook at
# /api/webhooks/email/resend and subscribe it to email.bounced and
# email.complained.
#
# Without this the route accepts nothing, which is the intended behaviour: a
# bounce handler that trusts an unsigned body is an unauthenticated way to mark
# any customer's order confirmation failed. The cost of leaving it blank is that
# bounces go unnoticed and a customer who was never told looks fine on every
# screen — which is the failure this endpoint exists to end.
RESEND_WEBHOOK_SECRET=
# The sending domain must be verified with the provider, or every message is
# rejected at the API — permanently, so it lands on the admin Messages screen
# rather than retrying.
EMAIL_FROM="Voltix <orders@example.ae>"
# Development: Mailpit, from infra/docker-compose.yml. Open http://localhost:8025
# to read what the store sent. Nothing ever leaves the machine.
SMTP_URL=smtp://localhost:1025
# WhatsApp Cloud API (Meta) — order updates and click-to-order.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# SMS aggregator. UAE senders must be registered with the TDRA.
SMS_API_KEY=
SMS_SENDER_ID=

# --- Storefront contact details --------------------------------------------
# The number, line and mailbox a shopper is invited to contact. Rendered in the
# footer, the hero, the 404, the empty-search state and the buy box.
#
# Left blank these render nothing at all — deliberately. A hardcoded
# placeholder that renders as a working wa.me link is how a stranger's phone
# ends up on a live storefront, which is exactly what these replaced.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Storefront security ---------------------------------------------------
# The nonce-based Content-Security-Policy in apps/storefront/src/proxy.ts is
# ENFORCED unless this is the exact string "false". Unset means enforced, so a
# deployment that never sets it is protected rather than quietly unprotected.
#
# Set it to false only to debug a policy you believe is blocking something: the
# header switches to Content-Security-Policy-Report-Only, violations still show
# up in the browser console, and nothing is actually blocked. It is a debugging
# escape hatch, not a configuration choice — leave it true.
CSP_ENFORCE=true

# --- Observability ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
LOG_LEVEL=info

# --- noon Marketplace ------------------------------------------------------
# Credentials come from the noon Partner Portal:
#   User & Access → Project users → +Add new → Service account
#   Type: apijwt  |  Role: Project Owner  → download the credentials JSON
#
# That file contains three fields — key_id, private_key and project_code.
# There is NO api key/secret pair: `private_key` is an RSA private key used to
# sign a short-lived login assertion, and it is never transmitted. Anything
# describing this integration as key+secret is describing an API noon does not
# have.
#
# A browser session cookie from being logged in to noon.partners is NOT a
# usable credential here. It expires within hours and is scoped to a human.
#
# Supply the credentials either as a file…
# NOON_CREDENTIALS_FILE=/absolute/path/to/noon_credentials_sensitive.json
#
# …or inline, which is what Vercel and CI need. Literal \n in the PEM is fine;
# the loader restores real newlines.
NOON_KEY_ID=
NOON_PRIVATE_KEY=
NOON_PROJECT_CODE=
#
# Gateway. Defaults to production. Point this at the sandbox while building —
# the alternative first integration test is one that zeroes the quantity on a
# product that is currently for sale.
#   production  https://noon-api-gateway.noon.partners
#   sandbox     https://sandbox-api-gateway.noon.partners
# NOON_API_BASE_URL=https://sandbox-api-gateway.noon.partners
#
# noon attributes rate-limit usage by User-Agent. Identify this app.
# NOON_USER_AGENT=VoltixCommerce/0.1 (+https://voltix.ae)
# NOON_API_TIMEOUT_MS=20000
#
# Sync cadence, in milliseconds. The worker calls the sync every tick and it
# throttles itself to these intervals.
# NOON_SWEEP_INTERVAL_MS=60000          # stock + price diff
# NOON_ORDER_PULL_INTERVAL_MS=300000    # import noon orders
# NOON_RECONCILE_INTERVAL_MS=900000     # drift check against noon's figures
