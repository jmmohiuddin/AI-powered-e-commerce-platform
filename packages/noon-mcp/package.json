{
  "name": "@voltix/noon-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing the noon Partner API as tools for AI assistants",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "noon-mcp": "./dist/index.js"
