{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,

    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@phoyev/db": ["packages/db/src/index.ts"],
      "@phoyev/db/*": ["packages/db/src/*"],
      "@phoyev/core": ["packages/core/src/index.ts"],
      "@phoyev/core/*": ["packages/core/src/*"],
      "@phoyev/commerce": ["packages/commerce/src/index.ts"],
      "@phoyev/commerce/*": ["packages/commerce/src/*"],
      "@phoyev/payments": ["packages/payments/src/index.ts"],
      "@phoyev/payments/*": ["packages/payments/src/*"],
      "@phoyev/ai": ["packages/ai/src/index.ts"],
      "@phoyev/ai/*": ["packages/ai/src/*"],
      "@phoyev/ui": ["packages/ui/src/index.ts"],
      "@phoyev/ui/*": ["packages/ui/src/*"],
      "@phoyev/media": ["packages/media/src/index.ts"],
      "@phoyev/media/*": ["packages/media/src/*"],
      "@phoyev/invoicing": ["packages/invoicing/src/index.ts"],
      "@phoyev/invoicing/*": ["packages/invoicing/src/*"],
      "@phoyev/config": ["packages/config/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "build"]
}
